# Dependencies
node_modules/

# Build output
dist/
build/
dist-ssr/
.vite/
*.tsbuildinfo

# Environment & secrets — never commit real values, keep only *.example templates
.env
.env.*
!.env.example
!.env.*.example

# Keys, certificates & credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.keystore
id_rsa
id_rsa.*
*.secret
secrets.*
credentials*.json
serviceAccount*.json
*.tfvars

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/

# User uploads (keep the folder, ignore its contents)
backend/uploads/*
!backend/uploads/.gitkeep

# OS & editor cruft
.DS_Store
Thumbs.db
.idea/
*.suo
*.swp
*.sw?
